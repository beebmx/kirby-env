{
    "name": "beebmx/kirby-env",
    "description": "Enable env variables to Kirby",
    "keywords": [
        "env",
        "dotenv",
        "phpdotenv",
        "kirby",
        "kirby-plugin",
        "kirby3",
        "kirby4",
        "kirby5"
    ],
    "version": "5.1.0",
    "type": "kirby-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Fernando Gutierrez",
            "homepage": "https://beeb.mx"
        }
    ],
    "require": {
        "php": "^8.2",
        "getkirby/composer-installer": "^1.2",
        "vlucas/phpdotenv": "^5.0"
    },
    "require-dev": {
        "getkirby/cms": "^3.0|^4.0|^5.0",
        "laravel/pint": "^1.0",
        "pestphp/pest": "^3.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "getkirby/composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "autoload": {
        "files": [
            "helpers.php"
        ],
        "psr-4": {
            "Beebmx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "kirby-cms-path": false
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
